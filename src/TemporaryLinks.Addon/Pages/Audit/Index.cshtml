@page
@model TemporaryLinks.Addon.Pages.Audit.IndexModel
@{
    ViewData["Title"] = "Audit Log";
}

<div class="page-head">
    <div>
        <h1>Audit log</h1>
        <p class="subtitle">Every consequential event across all links, newest first.</p>
    </div>
</div>

<div class="card">
    @if (Model.AuditEntries.Any())
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Link</th>
                        <th>Event</th>
                        <th>Description</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var audit in Model.AuditEntries)
                    {
                        <tr>
                            <td class="muted" style="white-space:nowrap;">@audit.Timestamp.ToLocalTime().ToString("MMM d, HH:mm")</td>
                            <td>
                                <a asp-page="/Links/Details" asp-route-id="@audit.TemporaryLinkId">@audit.TemporaryLink.Name</a>
                            </td>
                            <td>@audit.EventType</td>
                            <td class="muted">
                                @audit.Description
                                @if (!audit.Success && !string.IsNullOrEmpty(audit.ErrorMessage))
                                {
                                    <div class="text-danger" style="font-size:0.8rem;">@audit.ErrorMessage</div>
                                }
                            </td>
                            <td>
                                @if (audit.Success)
                                {
                                    <span class="pill ok">✓ OK</span>
                                }
                                else
                                {
                                    <span class="pill fail">✕ Failed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty">
            <div class="empty-icon">📋</div>
            <p>No activity has been recorded yet.</p>
        </div>
    }
</div>

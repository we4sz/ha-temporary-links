@page
@model TemporaryLinks.Addon.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>

<div class="mb-2">
    <a asp-page="/Links/Create" class="btn btn-primary">Create New Link</a>
    <a asp-page="/Links/Index" class="btn">View All Links</a>
</div>

<div class="stats-grid">
    <div class="card stat-card">
        <div class="stat-value">@Model.TotalLinks</div>
        <div class="stat-label">Total Links</div>
    </div>
    <div class="card stat-card">
        <div class="stat-value">@Model.ActiveLinks</div>
        <div class="stat-label">Active</div>
    </div>
    <div class="card stat-card">
        <div class="stat-value">@Model.UsedLinks</div>
        <div class="stat-label">Used</div>
    </div>
    <div class="card stat-card">
        <div class="stat-value">@Model.ExpiredLinks</div>
        <div class="stat-label">Expired</div>
    </div>
</div>

<div class="card">
    <h2>Recent Links</h2>
    @if (Model.RecentLinks.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Actions</th>
                    <th>Valid Until</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var link in Model.RecentLinks)
                {
                    <tr>
                        <td>@link.Name</td>
                        <td>
                            @if (!string.IsNullOrEmpty(link.Actions))
                            {
                                <code style="max-width: 300px; display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@link.Actions</code>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>@link.ValidUntil.ToLocalTime().ToString("g")</td>
                        <td><span class="status status-@link.Status.ToString().ToLower()">@link.Status</span></td>
                        <td>
                            <a asp-page="/Links/Details" asp-route-id="@link.Id" class="btn btn-primary btn-sm">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No links created yet. <a asp-page="/Links/Create">Create your first link</a></p>
    }
</div>

<div class="card">
    <h2>Recent Activity</h2>
    @if (Model.RecentActivity.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Link</th>
                    <th>Event</th>
                    <th>Success</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var audit in Model.RecentActivity)
                {
                    <tr>
                        <td>@audit.Timestamp.ToLocalTime().ToString("g")</td>
                        <td>@audit.TemporaryLink.Name</td>
                        <td>@audit.EventType</td>
                        <td>@(audit.Success ? "Yes" : "No")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No activity yet.</p>
    }
</div>

@page
@model TemporaryLinks.Addon.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-head">
    <div>
        <h1>Dashboard</h1>
        <p class="subtitle">An overview of the access you've handed out.</p>
    </div>
    <a asp-page="/Links/Create" class="btn btn-primary">+ Create link</a>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-value">@Model.TotalLinks</div>
        <div class="stat-label">Total</div>
    </div>
    <div class="stat-card is-active">
        <div class="stat-value">@Model.ActiveLinks</div>
        <div class="stat-label">Active</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">@Model.UsedLinks</div>
        <div class="stat-label">Used</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">@Model.ExpiredLinks</div>
        <div class="stat-label">Expired</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">@Model.RevokedLinks</div>
        <div class="stat-label">Revoked</div>
    </div>
</div>

<div class="card">
    <h3>Active links</h3>
    @if (Model.ActiveLinksList.Any())
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Actions</th>
                        <th>Expires</th>
                        <th class="num">Usage</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var link in Model.ActiveLinksList)
                    {
                        <tr>
                            <td><span class="primary-cell">@link.Name</span></td>
                            <td><partial name="_ActionChips" model="link.Actions" /></td>
                            <td>@link.ValidUntil.ToLocalTime().ToString("MMM d, HH:mm")</td>
                            <td class="num">@link.UsageCount / @(link.MaxUses >= 999 ? "∞" : link.MaxUses.ToString())</td>
                            <td>
                                <div class="row-actions">
                                    <a asp-page="/Links/Details" asp-route-id="@link.Id" class="btn btn-secondary btn-sm">View</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty">
            <div class="empty-icon">🔗</div>
            <p>No active links right now.</p>
            <a asp-page="/Links/Create" class="btn btn-primary">Create a link</a>
        </div>
    }
</div>

<div class="card">
    <h3>Recent activity</h3>
    @if (Model.RecentActivity.Any())
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Link</th>
                        <th>Event</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var audit in Model.RecentActivity)
                    {
                        <tr>
                            <td class="muted">@audit.Timestamp.ToLocalTime().ToString("MMM d, HH:mm")</td>
                            <td>@audit.TemporaryLink.Name</td>
                            <td>@audit.EventType</td>
                            <td>
                                @if (audit.Success)
                                {
                                    <span class="pill ok">✓ OK</span>
                                }
                                else
                                {
                                    <span class="pill fail">✕ Failed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">No activity yet.</p>
    }
</div>

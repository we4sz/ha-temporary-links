@page
@model TemporaryLinks.Addon.Pages.Contacts.IndexModel
@{
    ViewData["Title"] = "Contacts";
}

<div class="page-head">
    <div>
        <h1>Contacts</h1>
        <p class="subtitle">Reusable recipients you can pick when creating a link.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">+ Add contact</a>
</div>

<div class="card">
    @if (Model.Contacts.Any())
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Notes</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contact in Model.Contacts)
                    {
                        <tr>
                            <td><span class="primary-cell">@contact.Name</span></td>
                            <td class="code">@contact.PhoneNumber</td>
                            <td class="muted">@(string.IsNullOrEmpty(contact.Email) ? "—" : contact.Email)</td>
                            <td class="muted" style="max-width:20rem;">@(string.IsNullOrEmpty(contact.Info) ? "—" : contact.Info)</td>
                            <td>
                                <div class="row-actions">
                                    <a asp-page="Edit" asp-route-id="@contact.Id" class="btn btn-secondary btn-sm">Edit</a>
                                    <a asp-page="Delete" asp-route-id="@contact.Id" class="btn btn-danger btn-sm">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty">
            <div class="empty-icon">👤</div>
            <p>No contacts yet.</p>
            <a asp-page="Create" class="btn btn-primary">Add your first contact</a>
        </div>
    }
</div>

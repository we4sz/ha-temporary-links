@page "{id:guid}"
@model TemporaryLinks.Addon.Pages.Contacts.DeleteModel
@{
    ViewData["Title"] = "Delete Contact";
}

<h1>Delete Contact</h1>

@if (Model.Contact == null)
{
    <div class="alert alert-danger">Contact not found.</div>
}
else
{
    <div class="card">
        <div class="alert alert-warning">
            Are you sure you want to delete this contact? This action cannot be undone.
        </div>

        <h3>@Model.Contact.Name</h3>
        <dl class="props">
            <dt>Phone</dt>
            <dd>@Model.Contact.PhoneNumber</dd>
            @if (!string.IsNullOrEmpty(Model.Contact.Email))
            {
                <dt>Email</dt>
                <dd>@Model.Contact.Email</dd>
            }
            @if (!string.IsNullOrEmpty(Model.Contact.Info))
            {
                <dt>Notes</dt>
                <dd>@Model.Contact.Info</dd>
            }
            <dt>Created</dt>
            <dd>@Model.Contact.CreatedAt.ToLocalTime().ToString("f")</dd>
        </dl>

        <form method="post" class="form-actions">
            <button type="submit" class="btn btn-danger">Yes, delete contact</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
}

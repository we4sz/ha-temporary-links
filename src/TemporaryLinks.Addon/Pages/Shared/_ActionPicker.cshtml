@model TemporaryLinks.Addon.Services.IActionPickerSource
@* Picks an action from the home's actual services/entities and appends it to the #Input_Actions
   textarea, which every page hosting this partial must render with that id (asp-for="Input.Actions"
   with no overriding id generates it). Raw editing of that textarea remains the escape hatch. *@
@if (Model.PickerAvailable)
{
    <div class="form-group" id="actionPicker">
        <label>Add an action</label>
        <div class="picker-row">
            <select id="pickerService"><option value="">Choose an action…</option></select>
            <select id="pickerEntity"><option value="">Choose an entity…</option></select>
            <button type="button" class="btn btn-secondary" id="pickerAdd">Add</button>
        </div>
        <p class="form-hint">Pick what to do and on which device — the JSON below is generated for you, and stays editable.</p>
        <p id="pickerError" class="text-danger" style="display:none;"></p>
    </div>
    <script>
        (function () {
            var services = @Html.Raw(Model.ServicesJson);
            var entities = @Html.Raw(Model.EntitiesJson);
            var svcSelect = document.getElementById('pickerService');
            var entSelect = document.getElementById('pickerEntity');

            services.forEach(function (s) {
                var opt = document.createElement('option');
                opt.value = s.domain + '.' + s.service;
                opt.textContent = s.domain + '.' + s.service + (s.name ? ' — ' + s.name : '');
                svcSelect.appendChild(opt);
            });

            function refreshEntities() {
                var domain = (svcSelect.value || '').split('.')[0];
                var agnostic = ['homeassistant', 'script', 'scene', 'automation'];
                entSelect.innerHTML = '<option value="">Choose an entity…</option>';
                entities.forEach(function (e) {
                    var entityDomain = e.entityId.split('.')[0];
                    if (!domain || entityDomain === domain ||
                        (agnostic.indexOf(domain) >= 0 && domain !== '')) {
                        var opt = document.createElement('option');
                        opt.value = e.entityId;
                        opt.textContent = e.friendlyName ? e.friendlyName + ' (' + e.entityId + ')' : e.entityId;
                        entSelect.appendChild(opt);
                    }
                });
            }
            svcSelect.addEventListener('change', refreshEntities);
            refreshEntities();

            document.getElementById('pickerAdd').addEventListener('click', function () {
                if (!svcSelect.value) { return; }
                var action = { action: svcSelect.value };
                if (entSelect.value) { action.target = { entity_id: entSelect.value }; }
                var ta = document.getElementById('Input_Actions');
                var errorEl = document.getElementById('pickerError');
                var current = [];
                if (ta.value.trim()) {
                    try {
                        current = JSON.parse(ta.value);
                    } catch (e) {
                        // Don't clobber a hand-edited draft that doesn't parse yet — leave
                        // the textarea untouched and tell the operator why nothing happened.
                        errorEl.textContent = "Couldn't add — the current actions text isn't valid JSON; fix it or clear it first.";
                        errorEl.style.display = 'block';
                        return;
                    }
                    if (!Array.isArray(current)) { current = [current]; }
                }
                errorEl.style.display = 'none';
                current.push(action);
                ta.value = JSON.stringify(current, null, 2);
                // Let host-page listeners (e.g. the link form's "save as template" toggle)
                // react without this partial needing to know they exist.
                ta.dispatchEvent(new Event('input', { bubbles: true }));
            });
        })();
    </script>
}
else
{
    <div class="alert alert-warning">Couldn't load actions and entities from Home Assistant — enter actions as JSON below.</div>
}

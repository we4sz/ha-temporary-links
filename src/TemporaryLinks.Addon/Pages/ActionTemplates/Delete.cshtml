@page "{id:guid}"
@model TemporaryLinks.Addon.Pages.ActionTemplates.DeleteModel
@{
    ViewData["Title"] = "Delete Action Template";
}

<h1>Delete Action Template</h1>

@if (Model.Template == null)
{
    <div class="alert alert-danger">Template not found.</div>
}
else
{
    <div class="card">
        <div class="alert alert-warning">
            Are you sure you want to delete this template? This action cannot be undone.
        </div>

        <h3>@Model.Template.Name</h3>
        <dl class="props">
            <dt>Actions</dt>
            <dd><partial name="_ActionChips" model="Model.Template.Actions" /></dd>
            @if (!string.IsNullOrEmpty(Model.Template.Description))
            {
                <dt>Description</dt>
                <dd>@Model.Template.Description</dd>
            }
            <dt>Created</dt>
            <dd>@Model.Template.CreatedAt.ToLocalTime().ToString("f")</dd>
        </dl>

        <form method="post" class="form-actions">
            <button type="submit" class="btn btn-danger">Yes, delete template</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
}

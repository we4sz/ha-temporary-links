@page
@model TemporaryLinks.Addon.Pages.Links.IndexModel
@{
    ViewData["Title"] = "All Links";
}

<h1>All Links</h1>

<div class="mb-2">
    <a asp-page="Create" class="btn btn-primary">Create New Link</a>
</div>

<div class="card">
    <form method="get" class="mb-2">
        <label>Filter by status:</label>
        <select name="status" class="form-control" style="width: auto; display: inline-block;" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
            <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
            <option value="Used" selected="@(Model.StatusFilter == "Used")">Used</option>
            <option value="Expired" selected="@(Model.StatusFilter == "Expired")">Expired</option>
            <option value="Revoked" selected="@(Model.StatusFilter == "Revoked")">Revoked</option>
        </select>
    </form>

    @if (Model.Links.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Script</th>
                    <th>Valid From</th>
                    <th>Valid Until</th>
                    <th>Status</th>
                    <th>SMS</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var link in Model.Links)
                {
                    <tr>
                        <td>@link.Name</td>
                        <td><code>@link.ScriptEntityId</code></td>
                        <td>@link.ValidFrom.ToLocalTime().ToString("g")</td>
                        <td>@link.ValidUntil.ToLocalTime().ToString("g")</td>
                        <td><span class="status status-@link.Status.ToString().ToLower()">@link.Status</span></td>
                        <td>@(link.SmsSent ? "Sent" : "-")</td>
                        <td>
                            <a asp-page="Details" asp-route-id="@link.Id" class="btn btn-primary btn-sm">View</a>
                            @if (link.Status == LinkStatus.Active || link.Status == LinkStatus.Pending)
                            {
                                <a asp-page="Delete" asp-route-id="@link.Id" class="btn btn-danger btn-sm">Revoke</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No links found.</p>
    }
</div>

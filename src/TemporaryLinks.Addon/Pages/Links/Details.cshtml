@page "{id:guid}"
@model TemporaryLinks.Addon.Pages.Links.DetailsModel
@{
    ViewData["Title"] = "Link Details";
}

<h1>Link Details</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@if (Model.Link == null)
{
    <div class="alert alert-danger">Link not found.</div>
}
else
{
    <div class="card">
        <h2>@Model.Link.Name</h2>
        <p><span class="status status-@Model.Link.Status.ToString().ToLower()">@Model.Link.Status</span></p>

        <table>
            @if (!string.IsNullOrEmpty(Model.Link.Actions))
            {
                <tr>
                    <th>Actions</th>
                    <td>
                        <pre style="margin: 0; max-width: 600px; overflow-x: auto;">@Model.Link.Actions</pre>
                    </td>
                </tr>
            }
            <tr>
                <th>Valid From</th>
                <td>@Model.Link.ValidFrom.ToLocalTime().ToString("f")</td>
            </tr>
            <tr>
                <th>Valid Until</th>
                <td>@Model.Link.ValidUntil.ToLocalTime().ToString("f")</td>
            </tr>
            <tr>
                <th>Usage</th>
                <td>@Model.Link.UsageCount / @Model.Link.MaxUses</td>
            </tr>
            <tr>
                <th>Created</th>
                <td>@Model.Link.CreatedAt.ToLocalTime().ToString("f") by @Model.Link.CreatedBy</td>
            </tr>
            <tr>
                <th>Phone Number</th>
                <td>@Model.Link.RecipientPhoneNumber</td>
            </tr>
        </table>

        @if (Model.Link.Status == LinkStatus.Active)
        {
            <div class="mt-2">
                <h3>Link URL</h3>
                <div class="link-url">@Model.LinkUrl</div>
                <p class="mt-1 text-muted">Share this URL with the recipient (or send via SMS below)</p>
            </div>

            <div class="mt-2">
                @if (Model.IsTwilioConfigured)
                {
                    <form method="post" asp-page-handler="SendSms" asp-route-id="@Model.Link.Id"
                          style="display: inline;">
                        <button type="submit" class="btn btn-primary">Send SMS</button>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning" style="margin-top: 1rem;">
                        <strong>SMS functionality is disabled.</strong> Please configure Twilio settings (Account SID,
                        Auth Token, and Phone Number) in the addon configuration to enable SMS sending.
                    </div>
                }
                <a asp-page="Delete" asp-route-id="@Model.Link.Id" class="btn btn-danger">Revoke Link</a>

                <a asp-page="Index" class="btn">Back to List</a>
            </div>
        }
    </div>

    @if (Model.Link.SmsEntries.Any())
    {
        <div class="card mt-2">
            <h3>SMS History</h3>
            <table>
                <thead>
                <tr>
                    <th>Time</th>
                    <th>Content</th>
                    <th>Twilio SID</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var sms in Model.Link.SmsEntries.OrderByDescending(s => s.Timestamp))
                {
                    <tr>
                        <td>@sms.Timestamp.ToLocalTime().ToString("g")</td>
                        <td style="max-width: 400px; word-wrap: break-word;">@sms.Content</td>
                        <td style="font-family: monospace; font-size: 0.9em;">@sms.TwilioMessageSid</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <div class="card mt-2">
        <h3>Audit Log</h3>
        @if (Model.Link.AuditEntries.Any())
        {
            <table>
                <thead>
                <tr>
                    <th>Time</th>
                    <th>Event</th>
                    <th>Description</th>
                    <th>IP</th>
                    <th>Success</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var audit in Model.Link.AuditEntries.OrderByDescending(a => a.Timestamp))
                {
                    <tr>
                        <td>@audit.Timestamp.ToLocalTime().ToString("g")</td>
                        <td>@audit.EventType</td>
                        <td>@audit.Description</td>
                        <td>@audit.IpAddress</td>
                        <td>@(audit.Success ? "Yes" : "No")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No audit entries.</p>
        }
    </div>
}

@page
@model TemporaryLinks.Addon.Pages.Links.CreateModel
@{
    ViewData["Title"] = "Create Link";
}

<h1>Create New Link</h1>

<div class="card">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-group">
            <label asp-for="Input.Name"></label>
            <input asp-for="Input.Name" class="form-control" placeholder="e.g., Delivery Access" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Actions"></label>
            <textarea asp-for="Input.Actions" class="form-control" rows="8" placeholder='[{"action": "light.turn_on", "target": {"entity_id": "light.living_room"}}]'></textarea>
            <span asp-validation-for="Input.Actions" class="text-danger"></span>
            <small class="text-muted">
                JSON array of Home Assistant actions to execute when the link is clicked.
                <br/><strong>Examples:</strong>
                <br/>Turn on light: <code>[{"action": "light.turn_on", "target": {"entity_id": "light.hall"}}]</code>
                <br/>Unlock door: <code>[{"action": "lock.unlock", "target": {"entity_id": "lock.front_door"}}]</code>
                <br/>Run script: <code>[{"action": "script.my_script", "data": {"param": "value"}}]</code>
                <br/>Multiple: <code>[{"action": "light.turn_on", ...}, {"action": "notify.mobile_app", ...}]</code>
            </small>
        </div>

        <div class="form-group">
            <label asp-for="Input.ValidFrom"></label>
            <input asp-for="Input.ValidFrom" type="datetime-local" class="form-control" />
            <span asp-validation-for="Input.ValidFrom" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.ValidUntil"></label>
            <input asp-for="Input.ValidUntil" type="datetime-local" class="form-control" />
            <span asp-validation-for="Input.ValidUntil" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.MaxUses"></label>
            <input asp-for="Input.MaxUses" type="number" min="1" max="100" class="form-control" />
            <span asp-validation-for="Input.MaxUses" class="text-danger"></span>
            <small class="text-muted">Number of times this link can be used (1 = single use)</small>
        </div>

        <div class="form-group">
            <label asp-for="Input.RecipientPhoneNumber"></label>
            <input asp-for="Input.RecipientPhoneNumber" class="form-control" placeholder="+1234567890" />
            <span asp-validation-for="Input.RecipientPhoneNumber" class="text-danger"></span>
            <small class="text-muted">Phone number in E.164 format (leave empty to skip SMS)</small>
        </div>

        <div class="form-group">
            <label asp-for="Input.CustomMessage"></label>
            <textarea asp-for="Input.CustomMessage" class="form-control" rows="3"
                placeholder="Your temporary access link: {link}&#10;Valid from {start_time} to {end_time}"></textarea>
            <span asp-validation-for="Input.CustomMessage" class="text-danger"></span>
            <small class="text-muted">Use {link}, {start_time}, {end_time}, {name} as placeholders</small>
        </div>

        <button type="submit" class="btn btn-primary">Create Link</button>
        <a asp-page="Index" class="btn">Cancel</a>
    </form>
</div>

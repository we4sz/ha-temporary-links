@page
@model TemporaryLinks.Addon.Pages.Links.CreateModel
@{
    ViewData["Title"] = "Create Link";
}

<div class="page-head">
    <div>
        <h1>Create link</h1>
        <p class="subtitle">Hand out time-boxed, usage-limited access to your home.</p>
    </div>
    <a asp-page="Index" class="btn btn-secondary">← Back</a>
</div>

<div class="card">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-section">
            <h3>Basics</h3>
            <div class="form-group">
                <label asp-for="Input.Name"></label>
                <input asp-for="Input.Name" placeholder="e.g. Delivery access" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-section">
            <h3>Actions</h3>
            <div class="form-group">
                <label>Start from a template</label>
                <select id="templateSelect">
                    @foreach (var option in Model.TemplateOptions)
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                </select>
                <p class="form-hint">Pick a saved template, or build actions below. <a asp-page="/ActionTemplates/Create">Manage templates</a></p>
            </div>

            <partial name="_ActionPicker" model="Model" />

            <div class="form-group">
                <label asp-for="Input.Actions"></label>
                <textarea asp-for="Input.Actions" class="code" rows="6" placeholder='[{"action": "lock.unlock", "target": {"entity_id": "lock.front_door"}}]'></textarea>
                <span asp-validation-for="Input.Actions" class="text-danger"></span>
                <details class="examples mt-1">
                    <summary>JSON examples</summary>
                    <p class="form-hint">A JSON array of Home Assistant actions to run when the link is used.</p>
                    <ul class="form-hint code" style="margin:0; padding-left:1.1rem; line-height:1.9;">
                        <li>Turn on a light: <code>[{"action":"light.turn_on","target":{"entity_id":"light.hall"}}]</code></li>
                        <li>Unlock a door: <code>[{"action":"lock.unlock","target":{"entity_id":"lock.front_door"}}]</code></li>
                        <li>Run a script: <code>[{"action":"script.my_script","data":{"param":"value"}}]</code></li>
                    </ul>
                </details>
            </div>

            <div class="form-group" id="saveTemplateSection" style="display:none;">
                <label><input asp-for="SaveAsTemplate" type="checkbox" /> Save this action set as a template</label>
            </div>
        </div>

        <div class="form-section">
            <h3>Validity</h3>
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Input.ValidFrom"></label>
                    <input asp-for="Input.ValidFrom" type="datetime-local" />
                    <span asp-validation-for="Input.ValidFrom" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ValidUntil"></label>
                    <input asp-for="Input.ValidUntil" type="datetime-local" />
                    <span asp-validation-for="Input.ValidUntil" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Input.MaxUses"></label>
                <input asp-for="Input.MaxUses" type="number" min="1" max="100" />
                <span asp-validation-for="Input.MaxUses" class="text-danger"></span>
                <p class="form-hint">How many times the link can be used. 1 = single use.</p>
            </div>
        </div>

        <div class="form-section">
            <h3>Recipient <span class="muted" style="text-transform:none; letter-spacing:0; font-weight:400;">· optional</span></h3>
            <div class="form-group">
                <label>Choose a contact</label>
                <select id="contactSelect">
                    @foreach (var option in Model.ContactOptions)
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                </select>
                <p class="form-hint">Pick a saved contact, or type a number below. <a asp-page="/Contacts/Create">Manage contacts</a></p>
            </div>
            <div class="form-group">
                <label asp-for="Input.RecipientPhoneNumber"></label>
                <input asp-for="Input.RecipientPhoneNumber" id="phoneNumber" placeholder="+1234567890" />
                <span asp-validation-for="Input.RecipientPhoneNumber" class="text-danger"></span>
                <p class="form-hint">E.164 format. Leave empty to just copy and share the link yourself.</p>
            </div>
            <div class="form-group" id="saveContactSection" style="display:none;">
                <label><input asp-for="SaveAsContact" type="checkbox" /> Save this number as a contact</label>
            </div>
            <div class="form-group">
                <label asp-for="Input.CustomMessage"></label>
                <textarea asp-for="Input.CustomMessage" rows="3" placeholder="Your temporary access link: {link}&#10;Valid from {start_time} to {end_time}"></textarea>
                <span asp-validation-for="Input.CustomMessage" class="text-danger"></span>
                <p class="form-hint">Placeholders: {link}, {start_time}, {end_time}, {name}</p>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create link</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<script>
    document.getElementById('templateSelect').addEventListener('change', function () {
        document.getElementById('Input_Actions').value = this.value;
        toggleSaveTemplateSection();
    });
    document.getElementById('Input_Actions').addEventListener('input', toggleSaveTemplateSection);
    function toggleSaveTemplateSection() {
        var actionsInput = document.getElementById('Input_Actions');
        var templateSelect = document.getElementById('templateSelect');
        document.getElementById('saveTemplateSection').style.display =
            (actionsInput.value && actionsInput.value !== templateSelect.value) ? 'block' : 'none';
    }

    document.getElementById('contactSelect').addEventListener('change', function () {
        document.getElementById('phoneNumber').value = this.value;
        toggleSaveContactSection();
    });
    document.getElementById('phoneNumber').addEventListener('input', toggleSaveContactSection);
    function toggleSaveContactSection() {
        var phoneInput = document.getElementById('phoneNumber');
        var contactSelect = document.getElementById('contactSelect');
        document.getElementById('saveContactSection').style.display =
            (phoneInput.value && phoneInput.value !== contactSelect.value) ? 'block' : 'none';
    }
</script>

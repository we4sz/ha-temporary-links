@page "{id:guid}"
@model TemporaryLinks.Addon.Pages.Links.EditModel
@{
    ViewData["Title"] = "Edit Link";
}

<h1>Edit Link</h1>

@if (Model.Link == null)
{
    <div class="alert alert-danger">Link not found.</div>
}
else if (Model.Link.Status != TemporaryLinks.Addon.Models.LinkStatus.Active)
{
    <div class="alert alert-danger">Only active links can be edited.</div>
    <a asp-page="Details" asp-route-id="@Model.Link.Id" class="btn">Back to Details</a>
}
else
{
    <div class="card">
        <h2>@Model.Link.Name</h2>
        <p class="text-muted">Editing link parameters</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group">
                <label asp-for="Input.ValidFrom"></label>
                <input asp-for="Input.ValidFrom" type="datetime-local" class="form-control" />
                <span asp-validation-for="Input.ValidFrom" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ValidUntil"></label>
                <input asp-for="Input.ValidUntil" type="datetime-local" class="form-control" />
                <span asp-validation-for="Input.ValidUntil" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.MaxUses"></label>
                <input asp-for="Input.MaxUses" type="number" min="@Model.Link.UsageCount" max="100" class="form-control" />
                <span asp-validation-for="Input.MaxUses" class="text-danger"></span>
                <small class="text-muted">
                    Current usage: @Model.Link.UsageCount / @Model.Link.MaxUses
                    (Cannot be less than current usage)
                </small>
            </div>

            <div class="form-group">
                <label>Select Contact</label>
                <select id="contactSelect" class="form-control">
                    @foreach (var option in Model.ContactOptions)
                    {
                        <option value="@option.Value" selected="@(option.Value == Model.Input.RecipientPhoneNumber)">
                            @option.Text
                        </option>
                    }
                </select>
                <small class="text-muted">
                    Select a saved contact or enter manually below.
                    <a asp-page="/Contacts/Create">Add new contact</a>
                </small>
            </div>

            <div class="form-group">
                <label asp-for="Input.RecipientPhoneNumber"></label>
                <input asp-for="Input.RecipientPhoneNumber" id="phoneNumber" class="form-control" />
                <span asp-validation-for="Input.RecipientPhoneNumber" class="text-danger"></span>
                <small class="text-muted">Phone number in E.164 format</small>
            </div>

            <div class="form-group">
                <label asp-for="Input.CustomMessage"></label>
                <textarea asp-for="Input.CustomMessage" class="form-control" rows="3"
                    placeholder="Your temporary access link: {link}&#10;Valid from {start_time} to {end_time}"></textarea>
                <span asp-validation-for="Input.CustomMessage" class="text-danger"></span>
                <small class="text-muted">Use {link}, {start_time}, {end_time}, {name} as placeholders</small>
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-page="Details" asp-route-id="@Model.Link.Id" class="btn">Cancel</a>
        </form>

        <script>
            document.getElementById('contactSelect').addEventListener('change', function() {
                var phoneInput = document.getElementById('phoneNumber');
                phoneInput.value = this.value;
            });
        </script>
    </div>
}

@page "{id:int}"
@model TemporaryLinks.Addon.Pages.Links.DeleteModel
@{
    ViewData["Title"] = "Revoke Link";
}

<h1>Revoke Link</h1>

@if (Model.Link == null)
{
    <div class="alert alert-danger">Link not found.</div>
}
else
{
    <div class="card">
        <div class="alert alert-warning">
            Are you sure you want to revoke this link? This action cannot be undone.
        </div>

        <h2>@Model.Link.Name</h2>
        <table>
            <tr>
                <th>Action</th>
                <td><code>@Model.Link.Actions</code></td>
            </tr>
            <tr>
                <th>Valid Until</th>
                <td>@Model.Link.ValidUntil.ToLocalTime().ToString("f")</td>
            </tr>
            <tr>
                <th>Status</th>
                <td><span class="status status-@Model.Link.Status.ToString().ToLower()">@Model.Link.Status</span></td>
            </tr>
        </table>

        <form method="post" class="mt-2">
            <button type="submit" class="btn btn-danger">Yes, Revoke Link</button>
            <a asp-page="Details" asp-route-id="@Model.Link.Id" class="btn">Cancel</a>
        </form>
    </div>
}

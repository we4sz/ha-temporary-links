@model LinkExecutionResult
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Expired</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="result-page result-warning">
        <div class="card">
            <div class="result-icon">&#9203;</div>
            <h1>Link Expired</h1>
            <p>This link has expired and can no longer be used.</p>
            @if (Model.Link != null)
            {
                <p class="text-muted mt-2">Expired at: @Model.Link.ValidUntil.ToLocalTime().ToString("f")</p>
            }
        </div>
    </div>
</body>
</html>

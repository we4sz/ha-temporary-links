@model LinkExecutionResult
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Not Yet Valid</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="result-page result-warning">
        <div class="card">
            <div class="result-icon">&#128337;</div>
            <h1>Link Not Yet Valid</h1>
            <p>This link is not yet active. Please try again later.</p>
            @if (Model.Link != null)
            {
                <p class="mt-2">Valid from: <strong>@Model.Link.ValidFrom.ToLocalTime().ToString("f")</strong></p>
            }
        </div>
    </div>
</body>
</html>
